# Which LLM answers questions: anthropic | openai | extractive (offline, no key needed)
RAG_LLM_PROVIDER=anthropic
RAG_LLM_MODEL=claude-opus-5-5
# Embeddings: openai | fastembed (local, no key) | hashing (offline, tests only)
RAG_EMBEDDING_PROVIDER=fastembed
# Vector store: memory | chroma
RAG_VECTOR_STORE=memory
RAG_CHROMA_URL=http://localhost:8001
# Reranker: none | lexical | llm
RAG_RERANKER=llm

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
